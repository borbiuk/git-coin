{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/borbiuk/git-coin/config/coins.schema.json",
	"title": "git-coin configuration",
	"description": "Strict schema of config/coins.json. Rules that compare two fields (unique ids, a source needs an id in every enabled coin, stale_warn_minutes below stale_stop_minutes, ref_tolerance_minutes within window_minutes) are checked by src/config.ts, not here.",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "settings", "coins"],
	"properties": {
		"schema_version": { "const": 1 },
		"settings": { "$ref": "#/$defs/settings" },
		"coins": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/coin" }
		}
	},
	"$defs": {
		"sourceId": {
			"enum": ["kraken", "coinbase", "bitstamp", "coinmetrics"]
		},
		"direction": { "enum": ["up", "down", "both"] },
		"percent": {
			"type": "number",
			"exclusiveMinimum": 0,
			"maximum": 1000
		},
		"settings": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"quote",
				"stored_sources",
				"phase",
				"features",
				"min_spacing_seconds",
				"max_step_move_percent",
				"crosscheck_max_diff_percent",
				"publish_min_interval_minutes",
				"stale_warn_minutes",
				"stale_stop_minutes",
				"alert_defaults"
			],
			"properties": {
				"quote": { "const": "USD" },
				"stored_sources": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/sourceId" }
				},
				"phase": { "enum": ["test", "production"] },
				"features": {
					"type": "object",
					"additionalProperties": false,
					"required": ["alerts", "publish"],
					"properties": {
						"alerts": { "type": "boolean" },
						"publish": { "type": "boolean" }
					}
				},
				"min_spacing_seconds": {
					"type": "integer",
					"minimum": 1,
					"maximum": 3600
				},
				"max_step_move_percent": { "$ref": "#/$defs/percent" },
				"crosscheck_max_diff_percent": { "$ref": "#/$defs/percent" },
				"publish_min_interval_minutes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 1440
				},
				"stale_warn_minutes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10080
				},
				"stale_stop_minutes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10080
				},
				"alert_defaults": { "$ref": "#/$defs/alertDefaults" }
			}
		},
		"alertDefaults": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"direction",
				"cooldown_hours",
				"daily_issue_cap",
				"auto_close_hours",
				"move_1h",
				"move_24h"
			],
			"properties": {
				"enabled": { "type": "boolean" },
				"direction": { "$ref": "#/$defs/direction" },
				"cooldown_hours": {
					"type": "number",
					"minimum": 0,
					"maximum": 720
				},
				"daily_issue_cap": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100
				},
				"auto_close_hours": {
					"type": "number",
					"exclusiveMinimum": 0,
					"maximum": 720
				},
				"move_1h": { "$ref": "#/$defs/alertParams" },
				"move_24h": { "$ref": "#/$defs/alertParams" }
			}
		},
		"alertParams": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"window_minutes",
				"threshold_percent",
				"ref_tolerance_minutes"
			],
			"properties": {
				"window_minutes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10080
				},
				"threshold_percent": { "$ref": "#/$defs/percent" },
				"ref_tolerance_minutes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 10080
				}
			}
		},
		"alertParamsOverride": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"window_minutes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10080
				},
				"threshold_percent": { "$ref": "#/$defs/percent" },
				"ref_tolerance_minutes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 10080
				}
			}
		},
		"coin": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "enabled", "added", "sources"],
			"properties": {
				"id": { "type": "string", "pattern": "^[A-Z0-9]{2,10}$" },
				"name": { "type": "string", "minLength": 1, "maxLength": 60 },
				"role": { "const": "rate" },
				"enabled": { "type": "boolean" },
				"added": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
				},
				"sources": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kraken_pair": { "$ref": "#/$defs/sourceKey" },
						"coinbase_product": { "$ref": "#/$defs/sourceKey" },
						"bitstamp_market": { "$ref": "#/$defs/sourceKey" },
						"coinmetrics_asset": { "$ref": "#/$defs/sourceKey" },
						"coingecko_id": { "$ref": "#/$defs/sourceKey" }
					}
				},
				"alerts": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"enabled": { "type": "boolean" },
						"direction": { "$ref": "#/$defs/direction" },
						"cooldown_hours": {
							"type": "number",
							"minimum": 0,
							"maximum": 720
						},
						"daily_issue_cap": {
							"type": "integer",
							"minimum": 0,
							"maximum": 100
						},
						"auto_close_hours": {
							"type": "number",
							"exclusiveMinimum": 0,
							"maximum": 720
						},
						"move_1h": { "$ref": "#/$defs/alertParamsOverride" },
						"move_24h": { "$ref": "#/$defs/alertParamsOverride" }
					}
				},
				"note": { "type": "string", "maxLength": 500 }
			}
		},
		"sourceKey": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._-]{1,40}$"
		}
	}
}
