{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run lint)",
			"Bash(npm run lint:fix)",
			"Bash(npm run lint:docs)",
			"Bash(npm run lint:unused)",
			"Bash(npm run typecheck)",
			"Bash(npm run format)",
			"Bash(npm run format:check)",
			"Bash(npm run check)",
			"Bash(npm run check:versions)",
			"Bash(npm run check:outdated)",
			"Bash(npm test)",
			"Bash(npm run test)",
			"Bash(npx prettier --check *)",
			"Bash(./scripts/with-node24.sh npm run *)",
			"Bash(./scripts/with-node24.sh npm test)",
			"Bash(./scripts/with-node24.sh npm ci --ignore-scripts)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(./scripts/with-node24.sh git commit *)"
		],
		"ask": [
			"Bash(git push *)",
			"Bash(git pull *)",
			"Bash(git merge *)",
			"Bash(git stash *)",
			"Bash(git rebase *)",
			"Bash(npm install *)"
		],
		"deny": [
			"Bash(git push --force *)",
			"Bash(git reset --hard *)",
			"Bash(git clean *)",
			"Bash(git checkout --force *)"
		]
	}
}
